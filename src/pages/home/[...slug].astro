---
/**
 * Stubs for the old v1 URLs (the One.com site builder used a /home/ prefix).
 * GitHub Pages has no server-side redirects, so we do it with a meta refresh
 * plus rel=canonical — Google treats that like a 301, just more slowly.
 * Excluded from the sitemap in astro.config.mjs.
 */
export async function getStaticPaths() {
  const map: Record<string, string> = {
    'gallery': '/gallery',
    'fees': '/fees',
    'beginner-s-course': '/beginner-course',
    'what-is-kendo': '/what-is-kendo',
  };
  return Object.entries(map).map(([slug, to]) => ({ params: { slug }, props: { to } }));
}
const { to } = Astro.props;
// Deployment prefix, so the stub also works on the preview URL.
const href = `${import.meta.env.BASE_URL}${to.replace(/^\//, '')}`.replace(/\/{2,}/g, '/');
const target = new URL(to, Astro.site ?? 'https://kendosintra.pt').href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <title>Moved</title>
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${href}`} />
  </head>
  <body>
    <p><a href={href}>{target}</a></p>
    <script is:inline define:vars={{ href }}>location.replace(href);</script>
  </body>
</html>
