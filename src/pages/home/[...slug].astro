---
/**
 * Zaslepki pod stare URL-e z v1 (kreator One.com uzywal prefiksu /home/).
 * GitHub Pages nie ma przekierowan serwerowych, wiec robimy to meta-refreshem
 * plus rel=canonical — Google traktuje to jak przekierowanie 301, tylko wolniej.
 * Wylaczone z sitemapy w astro.config.mjs.
 */
export async function getStaticPaths() {
  const map: Record<string, string> = {
    'gallery': '/gallery',
    'fees': '/fees',
    'beginner-s-course': '/beginner-course',
    'what-is-kendo': '/what-is-kendo',
  };
  return Object.entries(map).map(([slug, to]) => ({ params: { slug }, props: { to } }));
}
const { to } = Astro.props;
const target = new URL(to, Astro.site ?? 'https://kendosintra.pt').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved</title>
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>This page has moved to <a href={to}>{target}</a>.</p>
    <script is:inline define:vars={{ to }}>location.replace(to);</script>
  </body>
</html>
