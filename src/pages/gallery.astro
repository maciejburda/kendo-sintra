---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageShell from '../components/PageShell.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

const lang = 'en' as const;
const entry = await getEntry('pages', lang + '/gallery')!;
const { Content } = await render(entry);
---
<Base lang={lang} path="gallery" title={entry.data.title} description={entry.data.description}>
  <PageShell title={entry.data.title} eyebrow={entry.data.eyebrow}>
    <Content />
  </PageShell>
  <GalleryGrid lang={lang} />
</Base>
