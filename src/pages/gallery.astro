---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageShell from '../components/PageShell.astro';

const lang = 'en' as const;
const entry = await getEntry('pages', lang + '/gallery')!;
const { Content } = await render(entry);

// Kazde zdjecie z src/assets/photos trafia do galerii automatycznie —
// dorzucenie pliku wystarczy, nie trzeba dotykac kodu.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const photos = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({
    src: mod.default,
    alt: path.split('/').pop()!.replace(/\.[a-z]+$/, '').replace(/-/g, ' '),
  }));
---
<Base lang={lang} path="gallery" title={entry.data.title} description={entry.data.description}>
  <PageShell title={entry.data.title} eyebrow={entry.data.eyebrow}>
    <Content />
  </PageShell>
  <div class="px-6 pb-20 md:px-16">
    <div class="mx-auto grid max-w-[1440px] gap-1.5 sm:grid-cols-2 lg:grid-cols-3">
      {photos.map((p) => (
        <Image src={p.src} alt={p.alt} widths={[480, 800, 1200]}
               sizes="(max-width:640px) 100vw, (max-width:1024px) 50vw, 33vw"
               loading="lazy" class="aspect-[3/2] w-full object-cover" />
      ))}
    </div>
    <!-- TODO: alt-teksty sa generowane z nazw plikow. Przy komplecie ~70 zdjec
         z one.com trzeba je opisac recznie — patrz README, sekcja "Zdjecia". -->
  </div>
</Base>
