---
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import FacebookFeed from '../../components/FacebookFeed.astro';
import Icon from '../../components/Icon.astro';
import { useTranslations } from '../../i18n/ui';
import { club } from '../../i18n/club';

const lang = 'en' as const;
const t = useTranslations(lang);
---
<Base lang={lang} path="news" title={t('news.title')}
      description={lang === 'pt'
        ? 'Notícias do Kendo Club Sintra — competições, graduações e seminários, directamente da nossa página de Facebook.'
        : 'News from Kendo Club Sintra — competitions, gradings and seminars, straight from our Facebook page.'}>
  <PageShell title={t('news.title')} />
  <div class="px-6 pb-20 md:px-16">
    <div class="mx-auto grid max-w-[1440px] items-start gap-12 lg:grid-cols-[1fr_500px]">
      <div class="flex flex-col gap-5">
        <p class="max-w-[46ch] text-19 leading-relaxed text-n-700">{t('news.fb')}</p>
        <a href={club.facebook} target="_blank" rel="noopener"
           class="tap self-start items-center gap-3 bg-navy px-7 py-4 text-16 font-bold text-white hover:bg-red">
          <Icon name="facebook" size={18} />Facebook
        </a>
      </div>
      <FacebookFeed lang={lang} height={780} />
    </div>
  </div>
</Base>
