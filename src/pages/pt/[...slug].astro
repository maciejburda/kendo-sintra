---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import ContactBand from '../../components/ContactBand.astro';
import ContactStrip from '../../components/ContactStrip.astro';
import FeeCards from '../../components/FeeCards.astro';

export async function getStaticPaths() {
  // gallery has its own route, with the photo grid
  const entries = await getCollection('pages', (e) =>
    e.id.startsWith('pt/') && !/\/(gallery)$/.test(e.id));
  return entries.map((entry) => ({
    params: { slug: entry.id.split('/').slice(1).join('/') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.split('/').slice(1).join('/');
---
<Base lang="pt" path={slug} title={entry.data.title} description={entry.data.description}
      localBusiness={slug === 'contact'}>
  <PageShell title={entry.data.title} eyebrow={entry.data.eyebrow} image={entry.data.image} lang="pt">
    {/* Straight under the banner, see the `after-banner` slot in PageShell. */}
    {slug === 'beginner-course' && <ContactStrip lang="pt" slot="after-banner" />}
    {slug === 'fees' && <FeeCards lang="pt" slot="after-banner" />}
    <Content />
  </PageShell>
  {/* /contact drops the "Get in touch / Where to find us" heading: the banner
      above it already says Contact, so the details come first. */}
  {slug === 'contact' && <ContactBand lang="pt" heading={false} />}
  {slug === 'schedule' && <ContactBand lang="pt" />}
</Base>
