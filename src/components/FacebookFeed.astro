---
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { club } from '../i18n/club';

interface Props { lang: Lang; height?: number; }
const { lang, height = 640 } = Astro.props;
const t = useTranslations(lang);
const locale = lang === 'pt' ? 'pt_PT' : 'en_GB';
---
<div class="flex flex-col gap-4">
  {/* Bez JS zostaje link do strony — wtyczka i tak nie zadziala bez skryptu.
      Szerokosc ustawiamy z JS, bo Page Plugin przyjmuje 180-500 px i nie
      przeplywa sam; iframe rozciagniety na sztywno zostawialby puste pole. */}
  <div id="fb-feed" class="min-h-[120px]"
       data-href={club.facebookPluginHref} data-locale={locale} data-height={String(height)}>
    <div class="flex flex-col items-start gap-3 border border-n-100 bg-n-050 px-6 py-6">
      <p class="text-14 leading-relaxed text-n-700">{t('consent.blocked.fb')}</p>
      <button type="button" data-load
              class="tap bg-navy px-6 py-3 text-14 font-bold uppercase tracking-[0.06em] text-white hover:bg-red">{t('consent.load')}</button>
      <a href={club.facebook} target="_blank" rel="noopener"
         class="tap items-center gap-3 text-14 font-bold text-red underline underline-offset-4">
        <Icon name="facebook" size={16} />{t('news.fb.fallback')}
      </a>
    </div>
  </div>
  <p class="text-14 leading-relaxed text-n-500">{t('news.fb.note')}</p>
</div>

<script is:inline>
  (function () {
    var slot = document.getElementById('fb-feed');
    if (!slot) return;
    var current = 0;
    function render() {
      var w = Math.max(180, Math.min(500, Math.floor(slot.clientWidth)));
      if (w === current) return;
      current = w;
      var q = 'href=' + encodeURIComponent(slot.dataset.href) +
              '&tabs=timeline&width=' + w + '&height=' + slot.dataset.height +
              '&small_header=false&adapt_container_width=true&hide_cover=false' +
              '&show_facepile=false&locale=' + slot.dataset.locale;
      slot.innerHTML = '';
      var f = document.createElement('iframe');
      f.src = 'https://www.facebook.com/plugins/page.php?' + q;
      f.title = 'Facebook';
      f.width = String(w);
      f.height = slot.dataset.height;
      f.loading = 'lazy';
      f.setAttribute('scrolling', 'no');
      f.setAttribute('frameborder', '0');
      f.setAttribute('allow', 'encrypted-media');
      f.style.cssText = 'border:0;overflow:hidden;display:block;max-width:100%';
      slot.appendChild(f);
    }
    slot.addEventListener('click', function (e) {
      if (e.target.closest('[data-load]')) { current = 0; render(); }
    });
    KCS.onGrant(render);
    var tid;
    addEventListener('resize', function () { clearTimeout(tid); tid = setTimeout(render, 250); });
  })();
</script>
