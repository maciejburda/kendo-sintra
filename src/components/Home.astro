---
import { Image } from 'astro:assets';
import Hero from './Hero.astro';
import ContactBand from './ContactBand.astro';
import { photos } from '../data/gallery';
import { useTranslations, localePath, type Lang } from '../i18n/ui';
import { club } from '../i18n/club';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * The photo strip. The first three show from `sm` up; the last two only once
 * there is room for five, so a wide screen gets more photographs rather than
 * three stretched ones. The strip is capped at the 1440 container like every
 * other block, so at five across each frame is portrait — which suits standing
 * kendoka better than it sounds.
 *
 * Both alt texts and files come from data/gallery.ts, so they are written once.
 *
 * The last two are lazy (Astro's default) and `display:none` below 3xl, and a
 * phone does not fetch them — checked against the BUILT site, where a 375px
 * viewport requests three strip images, not five. `astro dev` fetches all five,
 * so this has to be verified with `astro preview`, never with the dev server.
 */
const stripFiles = ['aip-42.jpg', 'aip-30.jpg', 'aip-50.jpg', 'aip-16.jpg', 'aip-26.jpg'];
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const strip = stripFiles.map((file) => ({
  img: files[`../assets/photos/${file}`].default,
  alt: photos.find((p) => p.file === file)?.[lang] ?? '',
}));

// The sensei's grade is deliberately not a headline figure here — same reason it
// came out of the hero. It stays on /about for anyone looking for it.
const facts = [
  { n: '2', label: t('facts.week'), note: t('facts.week.note') },
  { n: String(club.fees.adults), label: t('facts.fee'), note: t('facts.fee.note') },
  { n: 'EN / PT', label: t('facts.lang'), note: t('facts.lang.note') },
];
---
<Hero lang={lang} />

{/* One photo below sm — three stacked 330px images pushed the first real
    message more than a viewport down the page. Three from sm, five from 1800px.
    1800 rather than Tailwind's 2xl (1536): below that the container still fills
    most of the window and three reads better than five. */}
<div class="mx-auto grid max-w-[1440px] gap-1.5 sm:grid-cols-3 3xl:grid-cols-5">
  {strip.map((s, i) => (
    <Image src={s.img} alt={s.alt} widths={[320, 480, 720]}
           sizes="(max-width:640px) 100vw, (max-width:1799px) 33vw, 288px"
           class:list={[
             'h-[220px] w-full object-cover sm:h-[330px]',
             i > 0 && i < 3 && 'hidden sm:block',
             i >= 3 && 'hidden 3xl:block',
           ]} />
  ))}
</div>

{/* The colour field stays edge to edge; the copy inside lines up with the
    header, contact band and footer. Without the 1440 wrapper the 860px measure
    centres itself in the viewport, which on a 27" screen puts it 290px to the
    right of every other block on the page. */}
<section class="bg-red px-6 py-16 text-white md:px-16">
  <div class="mx-auto w-full max-w-[1440px]">
    <div class="flex max-w-[860px] flex-col items-start gap-6">
      <h2 class="display text-46 leading-[0.94] sm:text-62">{t('try.title')}</h2>
      <p class="text-19 leading-relaxed">{t('try.lead')}</p>
      <p class="text-16 text-white/85">{club.email} · {club.phone}</p>
      <div class="flex flex-wrap gap-4">
        <a href={`mailto:${club.email}`}
           class="tap bg-white px-8 py-4 text-16 font-bold uppercase tracking-[0.08em] text-red hover:bg-navy hover:text-white">
          {t('cta.email')}
        </a>
        <a href={`tel:${club.phoneHref}`}
           class="tap border-2 border-white px-8 py-4 text-16 font-bold uppercase tracking-[0.08em] text-white hover:bg-white hover:text-red">
          {t('cta.call')}
        </a>
      </div>
    </div>
  </div>
</section>

<div class="mx-auto grid max-w-[1440px] gap-px bg-n-100 sm:grid-cols-3">
  {facts.map((f) => (
    <div class="flex flex-col gap-2.5 bg-white px-8 py-12">
      <p class="display text-46 leading-none text-red">{f.n}</p>
      <p class="text-16 font-bold">{f.label}</p>
      <p class="text-14 leading-relaxed text-n-700">{f.note}</p>
    </div>
  ))}
</div>

<ContactBand lang={lang} />
