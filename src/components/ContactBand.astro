---
import { useTranslations, localePath, type Lang } from '../i18n/ui';
import { club } from '../i18n/club';

interface Props {
  lang: Lang;
  /** Course facts table. Off on the home page, where the red band already
      carries them — two copies of the same figures drift apart. */
  showCourseFacts?: boolean;
}
const { lang, showCourseFacts = true } = Astro.props;
const t = useTranslations(lang);
const signup = club.signupForm;
const subject = lang === 'pt' ? 'Inscrição — curso para iniciantes' : 'Sign-up — beginner course';
---
<section class="border-t border-n-100 bg-n-050 px-6 py-20 md:px-16">
  <div class="mx-auto grid max-w-[1440px] gap-16 lg:grid-cols-2">

    <div class="flex flex-col gap-7">
      <div class="flex flex-col gap-3">
        <p class="text-14 font-bold uppercase tracking-[0.18em] text-red">{t('contact.eyebrow')}</p>
        <h2 class="display text-46">{t('contact.title')}</h2>
        <p class="text-16 leading-relaxed text-n-700">{t('signup.lead')}</p>
      </div>

      {showCourseFacts && (
        <dl class="grid gap-px border border-n-100 bg-n-100 sm:grid-cols-2">
          <div class="flex flex-col gap-1 bg-white px-5 py-4">
            <dt class="text-12 font-bold uppercase tracking-[0.1em] text-n-500">{t('course.total')}</dt>
            <dd class="display text-25">{club.course.total} {club.fees.currency}</dd>
          </div>
          <div class="flex flex-col gap-1 bg-white px-5 py-4">
            <dt class="text-12 font-bold uppercase tracking-[0.1em] text-n-500">{t('course.duration')}</dt>
            <dd class="text-16 font-bold">{t('course.duration.value')}</dd>
          </div>
          <div class="flex flex-col gap-1 bg-white px-5 py-4">
            <dt class="text-12 font-bold uppercase tracking-[0.1em] text-n-500">{t('course.shinai')}</dt>
            <dd class="text-16 font-bold">{t('course.shinai.value')}</dd>
          </div>
          <div class="flex flex-col gap-1 bg-white px-5 py-4">
            <dt class="text-12 font-bold uppercase tracking-[0.1em] text-n-500">{t('course.trial')}</dt>
            <dd class="text-16 font-bold">{t('course.trial.value')}</dd>
          </div>
        </dl>
      )}

      {signup ? (
        <div class="flex flex-col gap-3">
          <a href={signup} target="_blank" rel="noopener"
             class="tap self-start bg-red px-10 py-5 text-16 font-bold uppercase tracking-[0.08em] text-white hover:bg-red-hover">
            {t('signup.cta')}
          </a>
          {/* The form opens on Google's side, so we say so plainly — the site itself
              sets no cookies and we do not want to blur that. */}
          <p class="text-14 text-n-500">{t('signup.newtab')}</p>
        </div>
      ) : (
        <div class="flex flex-col gap-3 border-l-4 border-red bg-white px-6 py-5">
          <p class="text-16 leading-relaxed text-n-700">{t('signup.pending')}</p>
          <a href={`mailto:${club.email}?subject=${encodeURIComponent(subject)}`}
             class="tap self-start bg-navy px-8 py-4 text-16 font-bold uppercase tracking-[0.08em] text-white hover:bg-red">
            {t('signup.write')}
          </a>
        </div>
      )}

      <p class="text-16 leading-relaxed text-n-700">{t('signup.or')}</p>
    </div>

    <div class="flex flex-col gap-9">
      <div class="flex flex-col gap-3 border-l-4 border-red bg-white px-6 py-5">
        <p class="text-16 font-bold text-navy">{t('venue.temp')}</p>
        <p class="text-16 leading-relaxed text-n-700">{t('venue.temp.body')}</p>
        <p class="text-14 leading-relaxed text-n-500">{t('venue.temp.after')}</p>
      </div>

      <div class="flex flex-col gap-4">
        <h2 class="text-14 font-bold uppercase tracking-[0.18em] text-red">{t('contact.hours')}</h2>
        <dl class="border-t border-n-100">
          {club.hours.map((h) => (
            <div class="flex justify-between border-b border-n-100 py-4 text-16">
              <dt class="font-bold">{t(h.day as any)}</dt>
              <dd class={h.open ? 'text-n-700' : 'text-n-500'}>{h.open ? `${h.open} — ${h.close}` : t('days.closed')}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="flex flex-col gap-4">
        <!-- The live Maps iframe sets Google cookies, so it is only injected once
             consent is granted (or the visitor clicks "load anyway"). Until then this
             slot renders a placeholder plus a plain link out to Google Maps.
             See README, section "Map". -->
        <div id="map-slot" class="relative flex min-h-[280px] items-center justify-center overflow-hidden border border-n-100 bg-n-050"
             data-src={club.venue.mapsEmbed} data-title={t('map.title')}>
          <div class="flex flex-col items-center gap-3 px-6 py-8 text-center">
            <p class="text-14 leading-relaxed text-n-700">{t('consent.blocked.map')}</p>
            <button type="button" data-load
                    class="tap bg-navy px-6 py-3 text-14 font-bold uppercase tracking-[0.06em] text-white hover:bg-red">{t('consent.load')}</button>
            <a href={club.venue.maps} target="_blank" rel="noopener"
               class="tap text-14 font-bold text-red underline underline-offset-4">{t('cta.maps')}</a>
          </div>
        </div>

        <address class="not-italic text-16 leading-relaxed">
          <span class="font-bold">{club.venue.name}</span><br />
          <span class="text-n-700">{club.venue.street}</span><br />
          <span class="text-n-700">{club.venue.postalCode} {club.venue.city}, {club.countryName}</span>
        </address>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var slot = document.getElementById('map-slot');
    if (!slot) return;
    function load() {
      var f = document.createElement('iframe');
      f.src = slot.dataset.src;
      f.title = slot.dataset.title;
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
      slot.innerHTML = '';
      slot.appendChild(f);
    }
    // "load anyway" applies to this visit only and does not enable analytics
    slot.addEventListener('click', function (e) {
      if (e.target.closest('[data-load]')) load();
    });
    KCS.onGrant(load);
  })();
</script>
