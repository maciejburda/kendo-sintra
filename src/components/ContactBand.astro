---
import { useTranslations, localePath, type Lang } from '../i18n/ui';
import { club } from '../i18n/club';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<section class="border-t border-n-100 bg-n-050 px-6 py-14 md:px-16 md:py-16">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-7">

    <div class="flex flex-col gap-3">
      <p class="text-14 font-bold uppercase tracking-[0.18em] text-red">{t('contact.reach')}</p>
      <h2 class="display text-46">{t('contact.visit')}</h2>
    </div>

    {/* Two columns so the blocks do not run down one half of an empty row. */}
    <div class="grid items-start gap-7 gap-x-12 lg:grid-cols-2">
      {/* Phone, email and address also sit in the footer. Repeating them here is
          deliberate: this is the section someone scrolls to when they want to
          reach the club, and making them hunt in the footer for it is worse than
          the duplication. */}
      <dl class="grid gap-px border border-n-100 bg-n-100 sm:grid-cols-2">
        <div class="flex flex-col gap-1 bg-white px-5 py-4">
          <dt class="text-12 font-bold uppercase tracking-[0.1em] text-n-500">{t('contact.phone')}</dt>
          <dd class="text-16 font-bold">
            <a href={`tel:${club.phoneHref}`} class="tap text-navy hover:text-red">{club.phone}</a>
          </dd>
        </div>
        <div class="flex flex-col gap-1 bg-white px-5 py-4">
          <dt class="text-12 font-bold uppercase tracking-[0.1em] text-n-500">{t('contact.email')}</dt>
          <dd class="text-16 font-bold">
            <a href={`mailto:${club.email}`} class="tap break-all text-navy hover:text-red">{club.email}</a>
          </dd>
        </div>
        <div class="flex flex-col gap-1 bg-white px-5 py-4 sm:col-span-2">
          <dt class="text-12 font-bold uppercase tracking-[0.1em] text-n-500">{t('contact.address')}</dt>
          <dd>
            <address class="not-italic text-16 leading-relaxed">
              <span class="font-bold">{club.venue.name}</span><br />
              <span class="text-n-700">{club.venue.street}</span><br />
              <span class="text-n-700">{club.venue.postalCode} {club.venue.city}, {club.countryName}</span>
            </address>
          </dd>
        </div>
      </dl>

      <div class="flex flex-col gap-4">
        <h2 class="text-14 font-bold uppercase tracking-[0.18em] text-red">{t('contact.hours')}</h2>
        <dl class="border-t border-n-100">
          {club.hours.map((h) => (
            <div class="flex justify-between border-b border-n-100 py-3 text-16">
              <dt class="font-bold">{t(h.day as any)}</dt>
              <dd class={h.open ? 'text-n-700' : 'text-n-500'}>{h.open ? `${h.open} — ${h.close}` : t('days.closed')}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="flex flex-col gap-4">
        <!-- The live Maps iframe sets Google cookies, so it is only injected once
             consent is granted (or the visitor clicks "load anyway"). Until then this
             slot renders a placeholder plus a plain link out to Google Maps.
             See README, section "Map". -->
        <div id="map-slot" class="relative flex min-h-[240px] items-center justify-center overflow-hidden border border-n-100 bg-n-050"
             data-src={club.venue.mapsEmbed} data-title={t('map.title')}>
          <div class="flex flex-col items-center gap-3 px-6 py-8 text-center">
            <p class="text-14 leading-relaxed text-n-700">{t('consent.blocked.map')}</p>
            <button type="button" data-load
                    class="tap bg-navy px-6 py-3 text-14 font-bold uppercase tracking-[0.06em] text-white hover:bg-red">{t('consent.load')}</button>
            <a href={club.venue.maps} target="_blank" rel="noopener"
               class="tap text-14 font-bold text-red underline underline-offset-4">{t('cta.maps')}</a>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var slot = document.getElementById('map-slot');
    if (!slot) return;
    function load() {
      var f = document.createElement('iframe');
      f.src = slot.dataset.src;
      f.title = slot.dataset.title;
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
      slot.innerHTML = '';
      slot.appendChild(f);
    }
    // "load anyway" applies to this visit only and does not enable analytics
    slot.addEventListener('click', function (e) {
      if (e.target.closest('[data-load]')) load();
    });
    KCS.onGrant(load);
  })();
</script>
