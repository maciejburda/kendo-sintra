---
import { useTranslations, localePath, type Lang } from '../i18n/ui';
import { club } from '../i18n/club';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const signup = club.signupForm;
const subject = lang === 'pt' ? 'Inscrição — curso para iniciantes' : 'Sign-up — beginner course';
---
<section class="border-t border-n-100 bg-n-050 px-6 py-20 md:px-16">
  <div class="mx-auto grid max-w-[1440px] gap-16 lg:grid-cols-2">

    <div class="flex flex-col gap-7">
      <div class="flex flex-col gap-3">
        <p class="text-14 font-bold uppercase tracking-[0.18em] text-red">{t('contact.eyebrow')}</p>
        <h2 class="display text-46">{t('contact.title')}</h2>
        <p class="text-16 leading-relaxed text-n-700">{t('signup.lead')}</p>
      </div>

      <dl class="grid gap-px border border-n-100 bg-n-100 sm:grid-cols-3">
        <div class="flex flex-col gap-1 bg-white px-5 py-4">
          <dt class="text-12 font-bold uppercase tracking-[0.1em] text-n-500">{t('course.total')}</dt>
          <dd class="display text-25">{club.course.total} {club.fees.currency}</dd>
        </div>
        <div class="flex flex-col gap-1 bg-white px-5 py-4">
          <dt class="text-12 font-bold uppercase tracking-[0.1em] text-n-500">{t('course.duration')}</dt>
          <dd class="text-16 font-bold">{t('course.duration.value')}</dd>
        </div>
        <div class="flex flex-col gap-1 bg-white px-5 py-4">
          <dt class="text-12 font-bold uppercase tracking-[0.1em] text-n-500">{t('course.shinai')}</dt>
          <dd class="text-16 font-bold">{t('course.shinai.value')}</dd>
        </div>
      </dl>

      {signup ? (
        <div class="flex flex-col gap-3">
          <a href={signup} target="_blank" rel="noopener"
             class="tap self-start bg-red px-10 py-5 text-16 font-bold uppercase tracking-[0.08em] text-white hover:bg-red-hover">
            {t('signup.cta')}
          </a>
          {/* Formularz otwiera sie u Google, wiec mowimy to wprost — strona sama
              nie ustawia zadnych cookies i nie chcemy tego zacierac. */}
          <p class="text-14 text-n-500">{t('signup.newtab')}</p>
        </div>
      ) : (
        <div class="flex flex-col gap-3 border-l-4 border-red bg-white px-6 py-5">
          <p class="text-16 leading-relaxed text-n-700">{t('signup.pending')}</p>
          <a href={`mailto:${club.email}?subject=${encodeURIComponent(subject)}`}
             class="tap self-start bg-navy px-8 py-4 text-16 font-bold uppercase tracking-[0.08em] text-white hover:bg-red">
            {t('signup.write')}
          </a>
        </div>
      )}

      <p class="text-16 leading-relaxed text-n-700">{t('signup.or')}</p>
    </div>

    <div class="flex flex-col gap-9">
      <div class="flex flex-col gap-4">
        <h2 class="text-14 font-bold uppercase tracking-[0.18em] text-red">{t('contact.hours')}</h2>
        <dl class="border-t border-n-100">
          {club.hours.map((h) => (
            <div class="flex justify-between border-b border-n-100 py-4 text-16">
              <dt class="font-bold">{t(h.day as any)}</dt>
              <dd class={h.open ? 'text-n-700' : 'text-n-500'}>{h.open ? `${h.open} — ${h.close}` : t('days.closed')}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="flex flex-col gap-4">
        <!-- Schemat zastepuje embed: zywy iframe Map ustawia cookies Google
             i przywraca banner zgody. Patrz README, sekcja "Mapa". -->
        <div class="relative h-[280px] overflow-hidden border border-n-100">
          <iframe src={club.mapsEmbed} title={t('map.title')} loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  class="absolute inset-0 h-full w-full border-0"></iframe>
        </div>
        <address class="not-italic text-16 leading-relaxed">
          <span class="font-bold">{club.street}</span><br />
          <span class="text-n-700">{club.postalCode} {club.city}, {club.countryName}</span>
        </address>
      </div>

    </div>
  </div>
</section>
