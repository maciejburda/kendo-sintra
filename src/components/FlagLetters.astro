---
/**
 * The two-letter language code with its flag showing through the letterforms,
 * plus a hairline edge so the glyphs still read at nav size — a Union Jack
 * squeezed into "EN" at 21px is otherwise mostly noise.
 *
 * Two flags are drawn, one in colour and one in pale blues, and the colour one
 * is faded in. The dim version keeps the flag's geometry rather than being a
 * flat tint, so an inactive Union Jack is still recognisably a Union Jack.
 *
 * State comes from the ANCESTOR link: lit when it carries aria-current, or on
 * hover and keyboard focus. That way the visual state and the one a screen
 * reader announces cannot drift apart — same rule as the nav items.
 */
interface Props { code: 'en' | 'pt'; label: string; }
const { code, label } = Astro.props;

const LIT = {
  en: { field: '#012169', white: '#FFFFFF', red: '#C8102E' },
  pt: { green: '#1E6B2A', red: '#D7262B', yellow: '#F5D32E', shield: '#FFFFFF' },
};
const DIM = {
  en: { field: '#9BAAD6', white: '#E9EEFA', red: '#6B82C2' },
  pt: { green: '#6B82C2', red: '#A8B7E2', yellow: '#E9EEFA', shield: '#E9EEFA' },
};
const c = { lit: LIT[code], dim: DIM[code] } as const;
const id = `fl-${code}`;
---
{/* Drawn to fill the 48x32 box, because it is seen only through the glyphs. */}
<svg viewBox="0 0 48 32" role="img" aria-label={label} class="flag-letters">
  <defs>
    <clipPath id={id}>
      <text x="24" y="26" text-anchor="middle" font-family="Anton, sans-serif"
            font-size="30" letter-spacing="0.5">{code.toUpperCase()}</text>
    </clipPath>
  </defs>

  <g clip-path={`url(#${id})`}>
    {(['dim', 'lit'] as const).map((tone) => (
      <g class={tone === 'lit' ? 'lit' : undefined}>
        {code === 'en' ? (
          <>
            <rect width="48" height="32" fill={c[tone].field} />
            <path d="M0 0 48 32M48 0 0 32" stroke={c[tone].white} stroke-width="7" />
            <path d="M0 0 48 32M48 0 0 32" stroke={c[tone].red} stroke-width="3.4" />
            <path d="M0 16h48M24 0v32" stroke={c[tone].white} stroke-width="10" />
            <path d="M0 16h48M24 0v32" stroke={c[tone].red} stroke-width="5" />
          </>
        ) : (
          <>
            <rect width="48" height="32" fill={c[tone].red} />
            <rect width="19" height="32" fill={c[tone].green} />
            <circle cx="19" cy="16" r="8" fill="none" stroke={c[tone].yellow} stroke-width="2.2" />
            <rect x="15.6" y="11.6" width="6.8" height="8.8" rx="1"
                  fill={c[tone].shield} stroke={c[tone].red} stroke-width="1.3" />
          </>
        )}
      </g>
    ))}
  </g>

  {/* NOT class="outline": that collides with Tailwind's .outline utility, which
      sets outline-style:solid and, inheriting currentColor from the link, paints
      a red box round each glyph. */}
  <text class="edge" x="24" y="26" text-anchor="middle" font-family="Anton, sans-serif"
        font-size="30" letter-spacing="0.5" fill="none" stroke-width="1.2"
        stroke-linejoin="round">{code.toUpperCase()}</text>
</svg>

<style>
  .flag-letters { display: block; height: 19px; width: auto; }
  .lit { opacity: 0; transition: opacity .28s ease; }
  .edge { stroke: #AEB6D0; transition: stroke .28s ease; }

  :global(.lang-sw[aria-current='true']) .lit,
  :global(.lang-sw:hover) .lit,
  :global(.lang-sw:focus-visible) .lit { opacity: 1; }

  :global(.lang-sw[aria-current='true']) .edge,
  :global(.lang-sw:hover) .edge,
  :global(.lang-sw:focus-visible) .edge { stroke: var(--color-navy); }

  @media (prefers-reduced-motion: reduce) {
    .lit, .edge { transition: none; }
  }
</style>
