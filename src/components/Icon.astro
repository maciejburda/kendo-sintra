---
/** Ikony rysowane wektorowo. Zadnych emoji, zadnego font-icon-a. */
interface Props { name: 'phone' | 'mail' | 'facebook' | 'instagram' | 'arrow'; size?: number; class?: string; }
const { name, size = 20, class: klass } = Astro.props;
const stroke = { fill: 'none', 'stroke-width': '1.9', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---
{name === 'phone' && (
  <svg viewBox="0 0 24 24" width={size} height={size} stroke="currentColor" {...stroke} class={`block ${klass ?? ""}`} aria-hidden="true" style="flex-shrink:0">
    <path d="M21 16.4v2.6a1.7 1.7 0 0 1-1.9 1.7 17 17 0 0 1-7.4-2.6 16.6 16.6 0 0 1-5.1-5.1A17 17 0 0 1 4 5.6 1.7 1.7 0 0 1 5.7 3.7h2.6a1.7 1.7 0 0 1 1.7 1.5c.1.9.3 1.7.6 2.5a1.7 1.7 0 0 1-.4 1.8l-1.1 1.1a13.6 13.6 0 0 0 5.1 5.1l1.1-1.1a1.7 1.7 0 0 1 1.8-.4c.8.3 1.6.5 2.5.6a1.7 1.7 0 0 1 1.4 1.7z"/>
  </svg>
)}
{name === 'mail' && (
  <svg viewBox="0 0 24 24" width={size} height={size} stroke="currentColor" {...stroke} class={`block ${klass ?? ""}`} aria-hidden="true" style="flex-shrink:0">
    <rect x="2.6" y="4.6" width="18.8" height="14.8" rx="2.2"/><path d="m3.2 6.2 8.8 6.4 8.8-6.4"/>
  </svg>
)}
{name === 'facebook' && (
  <svg viewBox="0 0 24 24" width={size} height={size} fill="currentColor" class={`block ${klass ?? ""}`} aria-hidden="true" style="flex-shrink:0">
    <path d="M14.5 8.5V6.9c0-.72.2-1.1 1.24-1.1H17V3.1c-.3-.04-1.1-.1-2-.1-2 0-3.4 1.22-3.4 3.47V8.5H9.2v2.9h2.4V21h2.9v-9.6h2.42l.38-2.9H14.5z"/>
  </svg>
)}
{name === 'instagram' && (
  <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.9" class={`block ${klass ?? ""}`} aria-hidden="true" style="flex-shrink:0">
    <rect x="3" y="3" width="18" height="18" rx="5.2"/><circle cx="12" cy="12" r="4.1"/><circle cx="17.1" cy="6.9" r="1.15" fill="currentColor" stroke="none"/>
  </svg>
)}
{name === 'arrow' && (
  <svg viewBox="0 0 24 24" width={size} height={size} stroke="currentColor" {...stroke} class={`block ${klass ?? ""}`} aria-hidden="true" style="flex-shrink:0">
    <path d="M4 12h15m-6-6 6 6-6 6"/>
  </svg>
)}
