---
import Prose from './Prose.astro';
interface Props { title: string; eyebrow?: string; }
const { title, eyebrow } = Astro.props;
---
<article class="px-6 py-16 md:px-16 md:py-24">
  <div class="mx-auto max-w-[1440px]">
    <header class="mb-10 flex flex-col gap-3 border-b border-n-100 pb-9">
      {eyebrow && <p class="text-14 font-bold uppercase tracking-[0.18em] text-red">{eyebrow}</p>}
      <h1 class="display text-46 md:text-62">{title}</h1>
    </header>
    <Prose><slot /></Prose>
  </div>
</article>
