---
import { useTranslations, type Lang } from '../i18n/ui';
import { club } from '../i18n/club';

/**
 * The fee table as tiles, in the same language as the facts row on the home page:
 * one figure per tile, large. A three-row markdown table made the only numbers on
 * the page look like a spreadsheet.
 *
 * The beginner course sits in its own navy strip rather than a fourth tile,
 * because it is a one-off total for three months and not a monthly rate — side
 * by side with the others, "60" would read as 60 EUR a month.
 *
 * Every figure comes from club.fees, so they are changed in one place.
 */
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const tiers = [
  { who: t('fees.adults'), amount: club.fees.adults },
  { who: t('fees.kids'), amount: club.fees.kids },
  { who: t('fees.visiting'), amount: club.fees.visiting },
];
---
<section class="mx-auto grid max-w-[1440px] gap-px bg-n-100 sm:grid-cols-3">
  {tiers.map((tier) => (
    <div class="flex flex-col gap-2 bg-n-050 px-8 py-8 sm:py-12">
      <p class="text-12 font-bold uppercase tracking-[0.16em] text-red">{tier.who}</p>
      <p class="display text-46 leading-none text-navy sm:text-62">{tier.amount}</p>
      <p class="text-14 font-bold text-n-700">{t('fees.month')}</p>
    </div>
  ))}
</section>

{/* px-8 so the copy lines up with the first tile above, rather than with the
    page's usual px-6/md:px-16 gutter. */}
<section class="on-navy mx-auto max-w-[1440px] bg-navy px-8 py-10 text-white">
  <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between md:gap-12">
    <div class="flex max-w-[520px] flex-col gap-1.5">
      <p class="text-12 font-bold uppercase tracking-[0.16em] text-on-navy-100">{t('fees.course')}</p>
      <p class="text-16 leading-relaxed">{t('fees.course.note')}</p>
    </div>
    <p class="display whitespace-nowrap text-46 leading-none md:text-62">
      {club.fees.course} <span class="text-19 md:text-25">{t('fees.total')}</span>
    </p>
  </div>
</section>
