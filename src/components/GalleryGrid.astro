---
import { Image, getImage } from 'astro:assets';
import { photos } from '../data/gallery';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * Publikowac zdjecia z rozpoznawalnymi twarzami nieletnich?
 * true  = stan jak w v1 (te zdjecia sa juz publiczne na kendosintra.pt)
 * false = ukrywa zdjecia oznaczone faces:true w src/data/gallery.ts
 * Patrz README, sekcja "Wizerunek".
 */
const SHOW_IDENTIFIABLE_MINORS = true;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });

const items = await Promise.all(
  photos
    .filter((p) => SHOW_IDENTIFIABLE_MINORS || !p.faces)
    .map((p) => ({ p, meta: files[`../assets/photos/${p.file}`]?.default }))
    .filter((x) => x.meta)
    .map(async ({ p, meta }) => {
      // Osobny, wiekszy wariant pod powiekszenie. Miniatury maja maks. 1200,
      // co w pelnym oknie widac.
      const full = await getImage({ src: meta!, width: 1600, format: 'webp' });
      return { meta: meta!, alt: p[lang], full: full.src };
    })
);
---
<div class="px-6 pb-20 md:px-16">
  <div class="mx-auto max-w-[1440px]">
    <p class="mb-5 text-14 text-n-500">{t('gallery.hint')}</p>

    <ul id="gal" class="grid list-none gap-1.5 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((it, i) => (
        <li>
          {/* Bez JS to zwykly link do pelnego zdjecia — galeria dziala dalej. */}
          <a href={it.full} data-full={it.full} data-alt={it.alt} data-i={i}
             class="group relative block focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-red"
             aria-label={`${it.alt} — ${t('gallery.open')}`}>
            <Image src={it.meta} alt={it.alt} widths={[480, 800, 1200]}
                   sizes="(max-width:640px) 100vw, (max-width:1024px) 50vw, 33vw"
                   loading="lazy" class="aspect-[3/2] w-full object-cover" />
            <span class="pointer-events-none absolute inset-0 bg-navy/0 transition-colors group-hover:bg-navy/25"></span>
          </a>
        </li>
      ))}
    </ul>

    <p class="mt-8 text-14 leading-relaxed text-n-500">
      {items.length} {lang === 'pt' ? 'fotografias' : 'photographs'}.{' '}
      {lang === 'pt'
        ? 'A sessão de dezembro de 2025 é de AiP Photography; as restantes foram tiradas nos treinos e competições do clube.'
        : 'The December 2025 shoot is by AiP Photography; the rest were taken at club training and competitions.'}
    </p>
  </div>
</div>

<dialog id="lb" class="on-navy" aria-label={t('nav.gallery')}>
  <figure>
    <img id="lb-img" alt="" />
    <figcaption aria-live="polite">
      {/* Opis zostaje w DOM, tylko schowany wizualnie — przy przeskakiwaniu
          strzalkami czytnik ekranu musi powiedziec, co sie zmienilo. */}
      <span id="lb-cap" class="sr-only"></span>
      <span id="lb-count"></span>
    </figcaption>
  </figure>
  <button id="lb-prev" type="button" aria-label={t('gallery.prev')}>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 4 7 12l8 8" /></svg>
  </button>
  <button id="lb-next" type="button" aria-label={t('gallery.next')}>
    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4l8 8-8 8" /></svg>
  </button>
  <button id="lb-close" type="button" aria-label={t('gallery.close')}>
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"
         stroke-linecap="round" aria-hidden="true"><path d="M5 5l14 14M19 5 5 19" /></svg>
  </button>
</dialog>

<style>
  #lb { width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh;
        margin: 0; padding: 0; border: 0; background: var(--color-navy); color: #fff; }
  #lb::backdrop { background: rgba(15, 20, 46, .96); }
  #lb figure { margin: 0; height: 100%; display: flex; flex-direction: column;
               align-items: center; justify-content: center; gap: 18px; padding: 56px 16px 24px; box-sizing: border-box; }
  #lb img { max-width: min(1600px, 94vw); max-height: 78dvh; width: auto; height: auto; object-fit: contain; }
  #lb figcaption { text-align: center; }
  #lb-count { font-size: var(--text-16); font-weight: 700; letter-spacing: .08em;
              font-variant-numeric: tabular-nums; color: var(--color-on-navy-100); }
  /* ukrycie wizualne bez wyjmowania z drzewa dostepnosci */
  #lb .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
                 overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  #lb button { position: absolute; display: inline-flex; align-items: center; justify-content: center;
               min-width: 52px; min-height: 52px; border: 0; background: rgba(255,255,255,.08);
               color: #fff; cursor: pointer; }
  #lb button:hover { background: var(--color-red); }
  #lb button:focus-visible { outline: 3px solid var(--color-red-on-navy); outline-offset: 3px; }
  #lb-prev { left: 12px; top: 50%; transform: translateY(-50%); }
  #lb-next { right: 12px; top: 50%; transform: translateY(-50%); }
  #lb-close { top: 12px; right: 12px; }
  @media (max-width: 640px) {
    #lb-prev, #lb-next { top: auto; bottom: 14px; transform: none; }
    #lb img { max-height: 66dvh; }
  }
</style>

<script is:inline>
  (function () {
    var gal = document.getElementById('gal');
    var lb = document.getElementById('lb');
    if (!gal || !lb || typeof lb.showModal !== 'function') return; // bez wsparcia zostaja linki

    var links = [].slice.call(gal.querySelectorAll('a[data-full]'));
    var img = document.getElementById('lb-img');
    var cap = document.getElementById('lb-cap');
    var count = document.getElementById('lb-count');
    var i = 0, opener = null;
    var sep = document.documentElement.lang === 'pt-PT' ? 'de' : 'of';

    function preload(n) {
      var a = links[(n + links.length) % links.length];
      if (a) { var p = new Image(); p.src = a.dataset.full; }
    }
    function show(n) {
      i = (n + links.length) % links.length;
      var a = links[i];
      img.src = a.dataset.full;
      img.alt = a.dataset.alt;
      cap.textContent = a.dataset.alt;
      count.textContent = (i + 1) + ' ' + sep + ' ' + links.length;
      preload(i + 1); preload(i - 1);
    }
    function open(n, from) { opener = from; show(n); lb.showModal(); }

    gal.addEventListener('click', function (e) {
      var a = e.target.closest('a[data-full]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      open(+a.dataset.i, a);
    });
    document.getElementById('lb-prev').addEventListener('click', function () { show(i - 1); });
    document.getElementById('lb-next').addEventListener('click', function () { show(i + 1); });
    document.getElementById('lb-close').addEventListener('click', function () { lb.close(); });

    lb.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1); }
    });
    // klik w tlo zamyka; klik w zdjecie lub przyciski nie
    lb.addEventListener('click', function (e) {
      if (e.target === lb || e.target.tagName === 'FIGURE') lb.close();
    });
    // focus wraca na miniature, od ktorej zaczelismy
    lb.addEventListener('close', function () { if (opener) opener.focus(); });

    var x0 = null;
    lb.addEventListener('touchstart', function (e) { x0 = e.changedTouches[0].clientX; }, { passive: true });
    lb.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 45) show(dx < 0 ? i + 1 : i - 1);
      x0 = null;
    }, { passive: true });
  })();
</script>
