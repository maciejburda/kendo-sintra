---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localePath, type Lang } from '../i18n/ui';
import { club } from '../i18n/club';
import { clubSchema, courseSchema } from '../data/schema';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** slug bez prefiksu jezyka, np. "fees" — steruje hreflang i stanem aktywnym w menu */
  path?: string;
  /** JSON-LD LocalBusiness — strona glowna i kontakt */
  localBusiness?: boolean;
  /** JSON-LD Course — strona glowna i strona kursu. Pozwala Google pokazac
      date i cene kursu w wynikach wyszukiwania. */
  course?: boolean;
}
const { lang, title, description, path = '', localBusiness = false, course = false } = Astro.props;

const site = Astro.site ?? new URL('https://kendosintra.pt');
// Podglad na *.github.io ma prefiks w BASE_URL. Nie wolno go zaindeksowac,
// bo konkurowalby w wynikach z docelowa domena jako duplikat.
const isPreview = (import.meta.env.BASE_URL ?? '/') !== '/';
/** Sciezka do pliku z public/ — swiadoma prefiksu wdrozenia. */
const asset = (f: string) => `${import.meta.env.BASE_URL}${f}`.replace(/\/{2,}/g, '/');
const canonical = new URL(localePath(lang, path), site).href;
const alternates = (['en', 'pt'] as Lang[]).map((l) => ({
  lang: l === 'en' ? 'en-GB' : 'pt-PT',
  href: new URL(localePath(l, path), site).href,
}));
const fullTitle = path === '' ? `${club.name} — ${lang === 'pt' ? 'Kendo em Sintra' : 'Kendo in Sintra'}` : `${title} | ${club.name}`;

---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-PT' : 'en-GB'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path), site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={club.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_GB'} />
    <meta property="og:image" content={new URL(asset('og.jpg'), site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${club.name} — ${lang === 'pt' ? 'kendo em Sintra' : 'kendo in Sintra'}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={asset("sitemap-index.xml")} />
    {club.ga4 && !isPreview && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${club.ga4}`}></script>
        <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${club.ga4}');`}></script>
      </>
    )}
    {localBusiness && <script type="application/ld+json" set:html={JSON.stringify(clubSchema(site))} />}
    {course && <script type="application/ld+json" set:html={JSON.stringify(courseSchema(lang, site, localePath(lang, 'beginner-course')))} />}
  </head>
  <body>
    <Header lang={lang} path={path} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
