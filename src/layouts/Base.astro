---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { localePath, type Lang } from '../i18n/ui';
import { club } from '../i18n/club';
import { clubSchema, courseSchema } from '../data/schema';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** slug without the language prefix, e.g. "fees" — drives hreflang and the active nav state */
  path?: string;
  /** JSON-LD LocalBusiness — home page and contact */
  localBusiness?: boolean;
  /** JSON-LD Course — home page and course page. Lets Google show the course
      date and price in search results. */
  course?: boolean;
}
const { lang, title, description, path = '', localBusiness = false, course = false } = Astro.props;

const site = Astro.site ?? new URL('https://kendosintra.pt');
// The *.github.io preview carries a prefix in BASE_URL. It must not be indexed,
// or it would compete with the production domain as a duplicate.
const isPreview = (import.meta.env.BASE_URL ?? '/') !== '/';
/** Path to a file in public/ — deployment-prefix aware. */
const asset = (f: string) => `${import.meta.env.BASE_URL}${f}`.replace(/\/{2,}/g, '/');
const canonical = new URL(localePath(lang, path), site).href;
const alternates = (['en', 'pt'] as Lang[]).map((l) => ({
  lang: l === 'en' ? 'en-GB' : 'pt-PT',
  href: new URL(localePath(l, path), site).href,
}));
const fullTitle = path === '' ? `${club.name} — ${lang === 'pt' ? 'Kendo em Sintra' : 'Kendo in Sintra'}` : `${title} | ${club.name}`;

---
<!doctype html>
<html lang={lang === 'pt' ? 'pt-PT' : 'en-GB'}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      /* Consent is stored in localStorage, not in a cookie — remembering the
         choice itself does not require consent. The map and GA scripts call
         KCS.ok() and listen for the "kcs-consent" event. */
      window.KCS = (function () {
        var K = 'kcs-consent';
        function get() { try { return localStorage.getItem(K); } catch (e) { return null; } }
        return {
          get: get,
          ok: function () { return get() === 'granted'; },
          set: function (v) {
            try { localStorage.setItem(K, v); } catch (e) {}
            document.dispatchEvent(new CustomEvent('kcs-consent', { detail: v }));
          },
          onGrant: function (fn) {
            if (this.ok()) { fn(); return; }
            document.addEventListener('kcs-consent', function h(e) {
              if (e.detail === 'granted') { document.removeEventListener('kcs-consent', h); fn(); }
            });
          },
        };
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path), site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={club.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_GB'} />
    <meta property="og:image" content={new URL(asset('og.jpg'), site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${club.name} — ${lang === 'pt' ? 'kendo em Sintra' : 'kendo in Sintra'}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={asset("sitemap-index.xml")} />
    {club.ga4 && !isPreview && (
      <script is:inline set:html={`KCS.onGrant(function(){
        var s=document.createElement('script');
        s.async=1; s.src='https://www.googletagmanager.com/gtag/js?id=${club.ga4}';
        document.head.appendChild(s);
        window.dataLayer=window.dataLayer||[];
        function gtag(){dataLayer.push(arguments);}
        gtag('js',new Date()); gtag('config','${club.ga4}');
      });`} />
    )}
    {localBusiness && <script type="application/ld+json" set:html={JSON.stringify(clubSchema(site))} />}
    {course && <script type="application/ld+json" set:html={JSON.stringify(courseSchema(lang, site, localePath(lang, 'beginner-course')))} />}
  </head>
  <body>
    <Header lang={lang} path={path} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <ConsentBanner lang={lang} />
  </body>
</html>
